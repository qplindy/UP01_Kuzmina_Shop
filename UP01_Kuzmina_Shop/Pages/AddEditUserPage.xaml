<Page x:Class="UP01_Kuzmina_Shop.Pages.AddEditUserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Добавление/Редактирование пользователя"
      Background="{DynamicResource MainBackground}">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="350">
            <!-- Динамический заголовок -->
            <TextBlock x:Name="TbTitle" Text="Добавление пользователя" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <!-- Поле Логин -->
            <TextBlock Text="Логин:" Margin="5,5,0,0"/>
            <TextBox x:Name="TbLogin" ToolTip="Введите логин"/>

            <!-- Поле Пароль -->
            <TextBlock Text="Пароль:" Margin="5,10,0,0"/>
            <PasswordBox x:Name="PbPassword" Height="30" Margin="5" VerticalContentAlignment="Center" ToolTip="Оставьте пустым, если не хотите менять пароль"/>

            <!-- Поле ФИО -->
            <TextBlock Text="ФИО:" Margin="5,10,0,0"/>
            <TextBox x:Name="TbFIO" ToolTip="Введите ФИО"/>

            <!-- Выпадающий список Роль -->
            <TextBlock Text="Роль:" Margin="5,10,0,0"/>
            <ComboBox x:Name="CbRole" Height="30" Margin="5" SelectedIndex="0"
                      Background="{DynamicResource MainBackground}"
                      Foreground="{DynamicResource TextColor}"
                      BorderBrush="{DynamicResource BorderColor}">
                <ComboBox.Resources>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="{DynamicResource MainBackground}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                        <Setter Property="Padding" Value="5"/>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PrimaryColor}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.Resources>

                <ComboBoxItem Content="Пользователь"/>
                <ComboBoxItem Content="Администратор"/>
            </ComboBox>

            <!-- Кнопки управления -->
            <Button x:Name="BtnSave" Content="Сохранить" Margin="5,20,5,5" Click="BtnSave_Click" ToolTip="Сохранить данные в БД"/>
            <Button x:Name="BtnBack" Content="Назад" Background="Gray" Margin="5,5,5,5" Click="BtnBack_Click" ToolTip="Вернуться к таблице"/>
        </StackPanel>
    </Grid>
</Page>