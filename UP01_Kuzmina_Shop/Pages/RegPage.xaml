<Page x:Class="UP01_Kuzmina_Shop.Pages.RegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Регистрация"
      Background="{DynamicResource MainBackground}">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="350">
            <TextBlock Text="Регистрация нового пользователя" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Логин:" Margin="5,5,0,0"/>
            <TextBox x:Name="TbLogin" ToolTip="Придумайте логин на английском" />

            <TextBlock Text="Пароль:" Margin="5,10,0,0"/>
            <PasswordBox x:Name="PbPassword" Height="30" Margin="5" VerticalContentAlignment="Center" ToolTip="Минимум 6 символов, только английские буквы и цифры"/>

            <TextBlock Text="Подтвердите пароль:" Margin="5,10,0,0"/>
            <PasswordBox x:Name="PbConfirmPassword" Height="30" Margin="5" VerticalContentAlignment="Center" ToolTip="Повторите пароль"/>

            <TextBlock Text="ФИО:" Margin="5,10,0,0"/>
            <TextBox x:Name="TbFIO" ToolTip="Ваши Фамилия Имя Отчество" />

            <TextBlock Text="Роль:" Margin="5,10,0,0"/>
            <ComboBox x:Name="CbRole" Height="30" Margin="5" SelectedIndex="0">
                <ComboBoxItem Content="Пользователь"/>
                <ComboBoxItem Content="Администратор"/>
            </ComboBox>

            <Button x:Name="BtnRegister" Content="Зарегистрироваться" Margin="5,20,5,5" Click="BtnRegister_Click" ToolTip="Создать аккаунт"/>
            <Button x:Name="BtnBack" Content="Назад" Background="Gray" Margin="5,5,5,5" Click="BtnBack_Click" ToolTip="Вернуться к авторизации"/>
        </StackPanel>
    </Grid>
</Page>