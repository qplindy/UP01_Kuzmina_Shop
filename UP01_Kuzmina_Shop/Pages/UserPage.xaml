<Page x:Class="UP01_Kuzmina_Shop.Pages.UserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01_Kuzmina_Shop.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Каталог товаров"
      Background="{DynamicResource MainBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Заголовок и фильтры -->
            <RowDefinition Height="*"/>
            <!-- Таблица с товарами -->
            <RowDefinition Height="Auto"/>
            <!-- Кнопка выхода -->
        </Grid.RowDefinitions>

        <!-- Панель фильтров -->
        <StackPanel Grid.Row="0" Margin="10">
            <TextBlock Text="Каталог одежды" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="TbSearch" Width="150" TextChanged="TbSearch_TextChanged" ToolTip="Введите название товара или бренд"/>

                <TextBlock Text="Сортировка по цене:" VerticalAlignment="Center" Margin="20,0,5,0"/>
                <ComboBox x:Name="CbSort" Width="150" SelectionChanged="CbSort_SelectionChanged">
                    <ComboBoxItem Content="По возрастанию" IsSelected="True"/>
                    <ComboBoxItem Content="По убыванию"/>
                </ComboBox>

                <TextBlock Text="Категория:" VerticalAlignment="Center" Margin="20,0,5,0"/>
                <ComboBox x:Name="CbCategory" Width="150" SelectionChanged="CbCategory_SelectionChanged"/>
            </StackPanel>
        </StackPanel>

        <!-- Таблица с товарами -->
        <DataGrid x:Name="DataGridProducts" Grid.Row="1" Margin="10" AutoGenerateColumns="False" IsReadOnly="True" 
                  CanUserAddRows="False" Background="{DynamicResource MainBackground}" RowBackground="{DynamicResource MainBackground}"
                  Foreground="{DynamicResource TextColor}" AlternatingRowBackground="{DynamicResource MainBackground}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Артикул" Binding="{Binding article}" Width="100"/>
                <DataGridTextColumn Header="Название" Binding="{Binding name}" Width="*"/>
                <DataGridTextColumn Header="Бренд" Binding="{Binding brand}" Width="120"/>
                <DataGridTextColumn Header="Размер" Binding="{Binding size}" Width="80"/>
                <DataGridTextColumn Header="Цвет" Binding="{Binding color}" Width="100"/>
                <DataGridTextColumn Header="Цена (руб.)" Binding="{Binding retail_price}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Кнопка выхода -->
        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Center" Margin="10">
            <Button Content="Выйти из аккаунта" Click="BtnLogout_Click" Background="Gray" Width="150"/>
        </StackPanel>
    </Grid>
</Page>