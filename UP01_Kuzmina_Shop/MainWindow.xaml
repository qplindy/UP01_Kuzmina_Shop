<Window x:Class="UP01_Kuzmina_Shop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Система управления сетью магазинов одежды" 
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MainBackground}"
        Closing="Window_Closing" Loaded="Window_Loaded">

    <Grid>
        <!-- Разделяем окно на 3 строки -->
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <!-- Верхняя панель -->
            <RowDefinition Height="*"/>
            <!-- Центральная часть (Страницы) -->
            <RowDefinition Height="30"/>
            <!-- Нижняя панель -->
        </Grid.RowDefinitions>

        <!-- Верхняя панель (Кнопки) -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" HorizontalAlignment="Right" Margin="0,5,10,0">
            <!-- Кнопка смены темы -->
            <Button x:Name="BtnTheme" Content="Сменить тему" Width="130" Click="BtnTheme_Click" ToolTip="Переключить светлую/темную тему"/>
        </StackPanel>

        <!-- Центральная часть (Сюда будем загружать страницы) -->
        <!-- NavigationUIVisibility="Hidden" скрывает лишнюю панель навигации -->
        <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden" Background="{DynamicResource MainBackground}"/>

        <!-- Нижняя панель (Дата и время) -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderColor}">
            <Grid>
                <TextBlock x:Name="TbDateTime" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"/>
                <TextBlock Text="© Кузьмина К.С. 2026" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12"/>
            </Grid>
        </Border>
    </Grid>
</Window>